# optional/large — include explicitly via REPLICA_INCLUDE_PICTURES=1
files/pictures/

# editor / OS cruft
*.swp
.DS_Store

# generated at runtime by gui.sh / python
.preview-thumb.png
.preview-large.png
__pycache__/
*.pyc

# intermediate icon sizes rasterized from icon.svg (only icon.png is used)
.icon-*.png

# machine-specific secrets — never publish (device identity keys)
files/config/kdeconnect/privateKey.pem
files/config/kdeconnect/certificate.pem
