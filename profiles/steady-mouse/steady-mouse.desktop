[Desktop Entry]
Type=Application
Name=Steady Mouse
GenericName=Tremor Filter
Comment=Hand-tremor mouse filter — smooths shake and steadies clicks
Exec=sh -c 'exec python3 "$HOME/.local/bin/tremor-gui.py"'
Icon=input-mouse
Terminal=false
Categories=Utility;Accessibility;
Keywords=tremor;mouse;steady;accessibility;pointer;shake;
StartupWMClass=ai.openclaw.steadymouse
